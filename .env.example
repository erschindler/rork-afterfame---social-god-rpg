# ─── Web app (web-afterfame/.env) ──────────────────────────────────────────
# Public values only. These are inlined into the browser bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Edge Functions (Supabase secrets, never in client code) ───────────────
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase. Do not set them yourself.

# Optional language model. Leave unset to use the built-in rule-based writer.
# Any OpenAI-compatible /chat/completions endpoint works (Ollama, llama.cpp,
# vLLM, LM Studio, or a hosted provider you configure).
TEXT_MODEL_ENDPOINT=
TEXT_MODEL_ID=llama3.1
TEXT_MODEL_API_KEY=
